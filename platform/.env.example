APP_NAME="GSoft AI Assistant"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com
APP_LOCALE=it

LOG_CHANNEL=daily
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gsai
DB_USERNAME=gsai
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file

# Redis opzionale (solo se disponibile sul server)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sale per l'hash delle email (SHA-256). NON cambiarlo dopo il primo avvio:
# invalida tutti i collegamenti di identita' esistenti.
GSAI_EMAIL_SALT=

# Tolleranza (secondi) sul timestamp delle richieste firmate e rate limit per sito
GSAI_SIGNATURE_TOLERANCE=300
GSAI_RATE_LIMIT_PER_MINUTE=600

ANTHROPIC_API_KEY=
